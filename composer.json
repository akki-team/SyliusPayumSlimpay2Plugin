{
  "name": "akki/sylius-payum-slimpay2-plugin",
  "description": "Payum Slimpay Bridge for Sylius",
  "type": "sylius-plugin",
  "require": {
    "php": "^8.2",
    "sylius/sylius": "^2.0",
    "payum/core": "^1.7",
    "payum/payum-bundle": "^2.5",
    "slimpay/hapiclient": "dev-master"
  },
  "require-dev": {
    "php-http/guzzle7-adapter": "^1.0"
  },
  "repositories": {
    "slimpayHapiclient": {
      "type": "vcs",
      "url": "https://github.com/ichiabdelkrim/hapiclient-php"
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Akki",
      "email": "support@akki.fr"
    }
  ],
  "prefer-stable": false,
  "autoload": {
    "psr-4": {
      "Akki\\SyliusPayumSlimpayPlugin\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  }
}
